            "useTrends": "default"
          },
          "table": {
            "skipEmptyValues": false
          }
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*\\[(.*?)\\].*",
            "renamePattern": "$1"
          }
        },
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "Guest",
              "Last *": "Status",
              "Last": "Status"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "running": {
                  "color": "green",
                  "text": "Running"
                },
                "stopped": {
                  "color": "red",
                  "text": "Stopped"
                },
                "paused": {
                  "color": "yellow",
                  "text": "Paused"
                }
              }
