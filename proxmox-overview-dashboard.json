            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${DS_ZABBIX}"
          },
          "queryType": "2",
          "group": {
            "filter": "/.*/"
          },
          "host": {
            "filter": "pve-cluster"
          },
          "application": {
            "filter": ""
