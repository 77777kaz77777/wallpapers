#!/usr/bin/env bash
# lab-seed.sh - create a small fake lab to test pve-lab.sh in a nested cluster
# Run on the FIRST node as root:   ./lab-seed.sh <other-node-name>
# Guests have no OS (they just sit at the BIOS) - that's all pve-lab.sh needs.
# Uses VMIDs 9101-9304, 501402 and 510400-510405; existing guests are never touched.
set -e
NODE1=$(hostname -s)
NODE2=${1:?usage: $0 <other-node-name>   (run this on the first node)}
[[ $NODE2 != "$NODE1" ]] || { echo "You are ON $NODE2. Run this on the other node and pass $NODE2."; exit 1; }
ssh -o BatchMode=yes "root@$NODE2" true || { echo "Can't ssh to root@$NODE2 - is it in the cluster?"; exit 1; }
STORE=local-lvm              # lvm-thin: snapshots work for VMs and containers

exists() { compgen -G "/etc/pve/nodes/*/qemu-server/$1.conf" >/dev/null || compgen -G "/etc/pve/nodes/*/lxc/$1.conf" >/dev/null; }

mk() {   # mk VMID NAME [extra qm create options]  - creates + snapshots ClassStart
    local id=$1 name=$2; shift 2
    if exists "$id"; then echo "VMID $id already used - skipping"; return 0; fi
    qm create "$id" --name "$name" --memory 256 --cores 1 --kvm 0 --ostype l26 \
        --scsihw virtio-scsi-single --scsi0 "$STORE:1" --net0 virtio,bridge=vmbr0 "$@"
    [[ $NOSNAP == 1 ]] || qm snapshot "$id" ClassStart
}

echo "== Open vSwitch bridge vmbr2 on both nodes"
for n in "$NODE1" "$NODE2"; do
    ssh "root@$n" "apt-get install -y openvswitch-switch >/dev/null && grep -q '^iface vmbr2' /etc/network/interfaces || {
        pvesh create /nodes/$n/network --iface vmbr2 --type OVSBridge --autostart 1 && pvesh set /nodes/$n/network; }"
done

echo "== Extra dir storage for qcow2 conversion"
pvesm status | grep -q '^lab-qcow2 ' || pvesm add dir lab-qcow2 --path /var/lib/lab-qcow2 --content images

echo "== Containers on $NODE1"
pveam update >/dev/null
TMPL=$(pveam available --section system | awk '/debian-12-standard/ {print $2; exit}')
[[ -f /var/lib/vz/template/cache/$TMPL ]] || pveam download local "$TMPL"
if ! exists 9103; then
    pct create 9103 "local:vztmpl/$TMPL" --hostname lab-fileserver --memory 256 --rootfs "$STORE:1" \
        --net0 name=eth0,bridge=vmbr0,ip=dhcp --unprivileged 1
    pct snapshot 9103 ClassStart
fi
exists 9210 || pct create 9210 "local:vztmpl/$TMPL" --hostname lab-timeserver --memory 256 --rootfs "$STORE:1" \
    --net0 name=eth0,bridge=vmbr0,ip=dhcp --unprivileged 1      # deliberately no snapshot

echo "== Lab-start guests on $NODE1"
mk 9102 lab-kali
mk 9201 lab-srv-01 --tags "lab;server"
mk 9202 lab-srv-02 --tags "lab;server"
NOSNAP=1 mk 9203 lab-srv-03 --tags "lab;server"
if ! qm listsnapshot 9203 | grep -q ClassStart; then
    qm start 9203 && qm snapshot 9203 ClassStart --vmstate 1     # RAM snapshot
fi
mk 9207 lab-tenable       --net1 virtio,bridge=vmbr2,firewall=0
mk 501402 dragos-sensor-1 --net1 virtio,bridge=vmbr2,firewall=1

echo "== Guests on $NODE2 (remote commands)"
for vm in "9303 lab-dmz2-fs-03" "9304 lab-dmz2-fs-04"; do
    set -- $vm
    exists "$1" && { echo "VMID $1 already used - skipping"; continue; }
    ssh "root@$NODE2" "qm create $1 --name $2 --memory 256 --cores 1 --kvm 0 --ostype l26 \
        --scsihw virtio-scsi-single --scsi0 $STORE:1 --net0 virtio,bridge=vmbr0 && qm snapshot $1 ClassStart"
done

echo "== Prep-workflow VMs 510400-510405 (EFI, raw disks, no snapshots)"
for i in 0 1 2 3 4 5; do
    keys=0; [[ $i == 0 ]] && keys=1                 # one already enrolled
    NOSNAP=1 mk "51040$i" "lab-ent-client-0$i" --bios ovmf --machine q35 --tags lab \
        --efidisk0 "$STORE:1,efitype=4m,pre-enrolled-keys=$keys"
done

echo
echo "Done. Next: ./pve-lab.sh  (turn on Dry-run in Settings for the first pass)"






#!/usr/bin/env bash
# docker-lab-test.sh - load and failure scenarios for the Zabbix Docker lab
# Run on the Docker host, next to the lab's docker-compose.yml stack.
#
# Usage: ./docker-lab-test.sh <scenario> [minutes]
#
# Scenarios:
#   web      20 parallel clients hammering Nginx        -> Nginx requests/connections
#   redis    redis-benchmark in a loop                   -> Redis ops/sec, clients, memory
#   db       pgbench transactions against PostgreSQL     -> PG TPS, connections, DB size
#   cpu      CPU-hungry container (1.5 cores)            -> Docker container CPU
#   oom      container that runs out of memory           -> memory ramp, OOM kill, exit 137
#   outage   stop Redis, then start it again             -> Redis down/up problems
#   all      web + redis + db + cpu together
#   cleanup  remove anything left over from an interrupted run
#
# All load runs in temporary containers named lab-test-*, so Ctrl+C
# (or the end of the run) removes everything cleanly.

set -uo pipefail

SCENARIO=${1:-}
MINUTES=${2:-5}
PREFIX="lab-test"
PG_USER="zbx_monitor"
PG_PASS="labpassword"
PG_DB="labdb"

log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

[[ -z $SCENARIO ]] && usage
[[ $MINUTES =~ ^[0-9]+$ ]] && (( MINUTES > 0 )) || { echo "minutes must be a positive whole number"; exit 1; }
command -v docker >/dev/null || { echo "docker not found"; exit 1; }

cleanup_containers() {
  local ids
  ids=$(docker ps -aq --filter "name=^${PREFIX}-")
  [[ -n $ids ]] && docker rm -f $ids >/dev/null && log "Removed test containers"
  # make sure an interrupted outage test doesn't leave Redis down
  if [[ $(docker inspect -f '{{.State.Running}}' lab-redis 2>/dev/null) == "false" ]]; then
    docker start lab-redis >/dev/null && log "Restarted lab-redis"
  fi
}

if [[ $SCENARIO == cleanup ]]; then cleanup_containers; exit 0; fi

# The lab's network, taken from the running Nginx container
NET=$(docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' lab-nginx 2>/dev/null | awk '{print $1}')
[[ -z $NET ]] && { echo "lab-nginx isn't running. Start the stack first: docker compose up -d"; exit 1; }

finish() {
  trap - EXIT INT TERM
  echo
  log "Stopping scenario '$SCENARIO'..."
  cleanup_containers
  log "Done."
}
trap finish EXIT
trap 'exit 130' INT TERM

start() {  # start <name> [docker run options...] -- <image> <command...>
  local name=$1; shift
  docker run -d --name "${PREFIX}-${name}" --network "$NET" "$@" >/dev/null \
    && log "Started ${PREFIX}-${name}" \
    || log "Failed to start ${PREFIX}-${name}"
}

web() {
  start web alpine:3.20 sh -c '
    for i in $(seq 20); do
      ( while :; do wget -q -O /dev/null http://nginx/; wget -q -O /dev/null http://nginx/basic_status; done ) &
    done; wait'
}

redis_load() {
  start redis redis:7-alpine sh -c '
    while :; do redis-benchmark -h redis -q -n 100000 -c 50 >/dev/null; done'
}

db() {
  start db -e PGPASSWORD="$PG_PASS" postgres:16-alpine sh -c "
    pgbench -h postgres -U $PG_USER -i -s 10 $PG_DB >/dev/null 2>&1 &&
    pgbench -h postgres -U $PG_USER -c 10 -j 2 -T 86400 $PG_DB"
}

cpu() {
  start cpu --cpus 1.5 alpine:3.20 sh -c '
    for i in 1 2; do ( while :; do :; done ) & done; wait'
}

oom() {
  start oom --memory 256m --memory-swap 256m alpine:3.20 tail /dev/zero
  log "Memory will climb to 256 MB and the kernel will kill the container."
}

outage() {
  docker stop lab-redis >/dev/null && log "Stopped lab-redis (Zabbix should raise a problem shortly)"
}

case "$SCENARIO" in
  web)    web ;;
  redis)  redis_load ;;
  db)     db ;;
  cpu)    cpu ;;
  oom)    oom ;;
  outage) outage ;;
  all)    web; redis_load; db; cpu ;;
  *)      usage ;;
esac

end=$(( $(date +%s) + MINUTES * 60 ))
oom_reported=0
while (( $(date +%s) < end )); do
  left=$(( end - $(date +%s) ))
  if [[ $SCENARIO == oom && $oom_reported == 0 ]]; then
    state=$(docker inspect -f '{{.State.Status}} {{.State.ExitCode}} {{.State.OOMKilled}}' ${PREFIX}-oom 2>/dev/null)
    if [[ $state == exited* ]]; then
      echo; log "lab-test-oom exited (status/exit code/OOM killed: $state)"
      oom_reported=1
    fi
  fi
  printf '\r[%s] %d min %02d s remaining (Ctrl+C to stop) ' \
    "$(date +%H:%M:%S)" $((left / 60)) $((left % 60))
  sleep 5
done

