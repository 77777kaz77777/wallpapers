wget https://repo.zabbix.com/zabbix/7.0/ubuntu/pool/main/z/zabbix-release/zabbix-release_latest_7.0+ubuntu24.04_all.deb
sudo dpkg -i zabbix-release_latest_7.0+ubuntu24.04_all.deb
sudo apt update
sudo apt install zabbix-agent2 zabbix-agent2-plugin-*

Then edit /etc/zabbix/zabbix_agent2.conf:

Server=<zabbix-lxc-ip>          # allows passive checks from the server
ServerActive=<zabbix-lxc-ip>    # enables active checks + autoregistration
Hostname=mint-vm101             # unique per VM
HostMetadata=linux-lab          # matched by your autoregistration action

Start the agent:

bash
sudo systemctl enable --now zabbix-agent2



ZABBIX_IP="192.168.77.170"
sudo sed -i \
  -e "s/^Server=.*/Server=$ZABBIX_IP/" \
  -e "s/^ServerActive=.*/ServerActive=$ZABBIX_IP/" \
  -e "s/^Hostname=.*/Hostname=fedora-vm102/" \
  -e "s/^[# ]*HostMetadata=.*/HostMetadata=linux-lab/" \
  /etc/zabbix/zabbix_agent2.conf


grep -E '^(Server|ServerActive|HostMetadata)=' /etc/zabbix/zabbix_agent2.conf
nc -zv 192.168.77.170 10051
sudo tail -20 /var/log/zabbix/zabbix_agent2.log


sudo dnf install zabbix-agent
dnf info zabbix-agent        # check the version
rpm -qc zabbix-agent         # shows where the config file lives


ZABBIX_IP="192.168.77.170"
sudo sed -i \
  -e "s/^Server=.*/Server=$ZABBIX_IP/" \
  -e "s/^ServerActive=.*/ServerActive=$ZABBIX_IP/" \
  -e "s/^Hostname=.*/Hostname=fedora-vm102/" \
  -e "s/^[# ]*HostMetadata=.*/HostMetadata=linux-lab/" \
  /etc/zabbix_agentd.conf



